# Supabase: use the session pooler URI from Connect if direct IPv6 is unavailable.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Render uses one trusted proxy hop. Leave 0 for a direct local server.
TRUST_PROXY_HOPS=0
# Match the frontend's Supabase project and public API key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Password recovery email (Gmail requires an app password, not your login password).
EMAIL_PROVIDER=smtp
# For Apps Script + Gmail on Render Free: EMAIL_PROVIDER=apps-script.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET=YOUR_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Render Free blocks SMTP: use EMAIL_PROVIDER=resend with these two settings.
# Use a verified sender domain for real users; resend.dev is owner-only testing.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_SENDER_EMAIL
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM=LetsGym <YOUR_SENDER_EMAIL>
# Generate once with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_RESET_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
