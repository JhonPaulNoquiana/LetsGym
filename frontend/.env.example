# Use your computer's LAN IP when running Expo Go on a physical phone.
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Supabase Dashboard > Connect / API Keys. Use the publishable key or legacy anon key.
# Never use a secret/service_role key or a Google client secret here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
